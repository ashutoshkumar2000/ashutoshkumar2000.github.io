---
import BaseLayout from '../layouts/BaseLayout.astro';
import Monogram from '../components/Monogram.astro';
import Icon from '../components/Icon.astro';
import EmploymentRoles from '../components/EmploymentRoles.astro';
import WorkDiagram from '../components/WorkDiagram.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import { profile, workStories, experience, skills, recognition, education } from '../data/portfolio';
import '../styles/portfolio.css';
---
<BaseLayout>
  <section class="hero page-width" id="top" aria-labelledby="hero-title">
    <div class="hero-topline"><span class="eyebrow"><span class="live-dot"></span> BENGALURU, INDIA</span><span class="eyebrow">A PERSONAL COLLECTION OF WORK & IDEAS</span></div>
    <div class="hero-grid"><div class="hero-copy"><p class="hero-intro" data-hero-reveal>Hello, I’m</p><h1 id="hero-title"><span class="name-line" data-hero-reveal>Ashutosh</span>{' '}<span class="name-line name-last" data-hero-reveal>Kumar<span class="name-period">.</span></span></h1><div class="hero-description" data-hero-reveal><p class="hero-role">{profile.role}.</p><p>I build across the stack, follow the problem<br class="desktop-break" /> beneath the surface, and care how it all fits together.</p></div><div class="hero-actions" data-hero-reveal><a class="button button-ink" href="#work">Selected work <Icon name="down" /></a><div class="hero-socials"><a class="text-link" href={profile.github} target="_blank" rel="noreferrer">GitHub <Icon name="external" /></a><a class="text-link" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <Icon name="external" /></a><a class="text-link" href="/resume">Resume <Icon name="document" /></a></div></div></div><Monogram /></div>
    <div class="hero-baseline"><span class="eyebrow">SYSTEMS THINKING. HANDS-ON BUILDING.</span><a class="scroll-link" href="#about">A LITTLE MORE ABOUT ME <Icon name="down" /></a></div>
  </section>
  <section class="about-section page-width section-space" id="about" aria-labelledby="about-title"><div class="section-label"><span class="eyebrow">01 / THE PERSON BEHIND THE CODE</span><span class="section-asterisk" data-turn aria-hidden="true">✳</span></div><div class="about-content"><h2 id="about-title" data-reveal>I like knowing<br />how the <em>whole thing</em><br />works.</h2><div class="about-text" data-reveal><p>I’m a software engineer based in Bengaluru, currently at <a class="inline-link" href="#experience">UptimeAI</a>. My work moves between system design, backend services, frontend experiences and the infrastructure underneath.</p><p>That range is what I enjoy: finding where a request gets stuck, giving a rigid data model room to grow, or following a problem from the first question all the way into production.</p><p class="about-signoff">From the big picture to the last detail.<Icon name="connected" class="signoff-mark" /></p></div></div><div class="about-footnote"><span>BACKEND DEPTH</span><span aria-hidden="true">/</span><span>FRONTEND CARE</span><span aria-hidden="true">/</span><span>END-TO-END OWNERSHIP</span></div></section>
  <section class="work-section ink-section" id="work" aria-labelledby="work-title"><div class="page-width work-grid"><div class="work-intro"><p class="eyebrow">02 / ENGINEERING WORK</p><h2 id="work-title">Behind<br />the <em>build.</em></h2><p>A few problems I’ve worked through at UptimeAI. The decisions, the details, and what changed.</p><div class="work-context"><span class="live-dot"></span><span>UPTIMEAI<br /><small>MAY 2023 — PRESENT</small></span></div><a class="text-link" href="#experience">Full experience <Icon name="down" /></a></div><div class="work-stories">{workStories.map(story => <article class="work-story" id={`work-${story.id}`} data-story><div class="story-top"><span>{story.number}</span><span>{story.category}</span><Icon name={story.id === 'sync' ? 'parallel' : story.id === 'email' ? 'verifiedMail' : 'branches'} class="story-symbol" /></div><h3 data-reveal>{story.title.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h3><p class="story-problem">{story.intro}</p><p>{story.decision}</p><WorkDiagram kind={story.id}/><div class="story-result"><strong class:list={[{ 'result-words': story.id === 'hierarchy' }]}>{story.result}</strong><div><span>{story.resultLabel}</span><small>{story.note}</small></div></div><ul class="tags">{story.tags.map(tag => <li>{tag}</li>)}</ul></article>)}</div></div></section>
  <section class="experience-section page-width section-space" id="experience" aria-labelledby="experience-title"><div class="section-heading"><div><p class="eyebrow">03 / THE PATH SO FAR</p><h2 id="experience-title" data-reveal>Where I’ve<br /><em>put it to work.</em></h2></div><a class="text-link" href="/resume">View full resume <Icon name="document" /></a></div><div class="experience-list">{experience.map((job, index) => <article class="experience-item" data-reveal><div class="experience-date"><span class="eyebrow">{job.period}</span><span>{job.location}</span></div><div class="experience-main"><span class="experience-number">0{index + 1}</span><h3>{job.company}</h3><EmploymentRoles role={job.role} history={job.roleHistory} /><p>{job.summary}</p><details class="experience-details"><summary>What I worked on <Icon name="plus" /></summary><ul>{job.highlights.map(item => <li>{item}</li>)}</ul></details></div></article>)}</div></section>
  <section class="projects-section" id="projects" aria-labelledby="projects-title"><div class="page-width section-space"><div class="section-heading"><div><p class="eyebrow">04 / OUTSIDE THE DAY JOB</p><h2 id="projects-title" data-reveal>My own<br /><em>workbench.</em></h2></div><p class="section-aside">Independent builds. Questions worth exploring.<br />An ongoing collection, with room to grow.</p></div><ProjectGallery /></div></section>
  <section class="toolkit-section page-width section-space" id="toolkit" aria-labelledby="toolkit-title"><div class="toolkit-heading"><p class="eyebrow">05 / TOOLS OF THE TRADE</p><h2 id="toolkit-title" data-reveal>A practical<br /><em>set of tools.</em></h2><p>The stack changes with the problem.<br />These are the tools I know my way around.</p></div><dl class="toolkit-list">{skills.map((skill, index) => <div data-reveal><dt><span>0{index + 1}</span>{skill.label}</dt><dd>{skill.items}</dd></div>)}</dl></section>
  <section class="recognition-section ink-section" aria-labelledby="recognition-title"><div class="page-width section-space"><div class="recognition-heading"><p class="eyebrow">06 / A FEW MILESTONES</p><h2 id="recognition-title" data-reveal>Work that’s been<br /><em>recognised.</em></h2></div><div class="recognition-grid">{recognition.map(award => <article data-reveal><span class="award-mark" aria-hidden="true">✳</span><span class="award-value">{award.value}</span><h3>{award.title}</h3><p>{award.context}</p></article>)}</div><div class="education" data-reveal><span class="education-medal" aria-hidden="true"><Icon name="medal" /></span><div><h3>{education.degree}</h3><p>{education.school} · {education.location} · {education.period}</p></div><div class="education-result"><strong>{education.gpa}</strong><span>{education.distinction}</span></div></div></div></section>
  <section class="contact-section page-width section-space" id="contact" aria-labelledby="contact-title"><div class="contact-top"><p class="eyebrow">07 / SAY HELLO</p><span class="contact-monogram" aria-hidden="true">a<span>k</span></span></div><h2 id="contact-title" data-reveal>Good things start<br />with a <em>conversation.</em></h2><p>Have an interesting engineering problem, a project idea,<br class="desktop-break" /> or something you think I should see? I’d like to hear it.</p><div class="email-row"><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<Icon name="mail" /></a><button class="copy-email" type="button" data-copy-email={profile.email} hidden aria-label="Copy email address"><Icon name="copy" /></button></div><span class="copy-feedback" role="status" aria-live="polite"></span><div class="contact-links"><span>{profile.location}</span><a href={profile.github} target="_blank" rel="noreferrer">GitHub <Icon name="external" /></a><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <Icon name="external" /></a><a href="/resume">Resume <Icon name="document" /></a></div></section>
  <script>import '../scripts/portfolio';</script>
</BaseLayout>
