---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import EmploymentRoles from '../components/EmploymentRoles.astro';
import { profile, experience, skills, tools, recognition, education, projects } from '../data/portfolio';
import '../styles/resume.css';
---
<BaseLayout title={`Resume — ${profile.name}, ${profile.role}`} description={`${profile.name} — ${profile.role}. Experience, projects, skills and education.`} resume>
  <div class="resume-toolbar page-width"><a class="text-link" href="/"><Icon name="back" /> Back to portfolio</a><button class="button button-ink" data-print hidden>Print / Save as PDF <Icon name="printer" /></button></div>
  <article class="resume-document page-width"><header class="resume-header"><p class="eyebrow">RESUME</p><h1>{profile.name}</h1><p class="resume-role">{profile.role}</p><div class="resume-contact"><a href={`mailto:${profile.email}`}>{profile.email}</a><span>{profile.location}</span><a data-social href={profile.github}>GitHub</a><a data-social href={profile.linkedin}>LinkedIn</a></div></header>
    <section aria-labelledby="resume-experience"><h2 id="resume-experience">Work experience</h2>{experience.map(job => <section class="resume-job"><div class="resume-job-heading"><h3>{job.company}</h3><span>{job.period}</span></div><p class="resume-job-location">{job.location}</p><EmploymentRoles role={job.role} history={job.roleHistory} /><p class="resume-summary">{job.summary}</p><ul>{job.highlights.map(highlight => <li>{highlight}</li>)}</ul></section>)}</section>
    <section aria-labelledby="resume-projects"><h2 id="resume-projects">Independent projects</h2>{projects.map(project => <section class="resume-project"><div class="resume-job-heading"><h3>{project.title}</h3><span>{project.status}</span></div><p>{project.summary}</p><p class="resume-summary">Planned stack: Angular, Node.js, TypeScript, PostgreSQL, Airwallex APIs / sandbox and an LLM with tool calling. Deterministic services enforce financial calculations, transaction validation and authorisation.</p>{project.links.map(link => <a href={link.url}>{link.url}</a>)}</section>)}</section>
    <section aria-labelledby="resume-skills"><h2 id="resume-skills">Skills & tools</h2><dl>{skills.map(skill => <div><dt>{skill.label}</dt><dd>{skill.items}</dd></div>)}<div><dt>Development tools</dt><dd>{tools}</dd></div></dl></section>
    <section aria-labelledby="resume-education"><h2 id="resume-education">Education</h2><div class="resume-job-heading"><h3>{education.school}</h3><span>{education.period}</span></div><p>{education.degree} · GPA {education.gpa} · {education.distinction}</p><p class="resume-summary">{education.location}</p></section>
    <section aria-labelledby="resume-recognition"><h2 id="resume-recognition">Recognition</h2><ul>{recognition.map(award => <li><strong>{award.title}</strong> — {award.value === 'Recognition' ? award.context : `${award.value}. ${award.context}`}</li>)}</ul></section>
  </article>
  <script>const button = document.querySelector<HTMLButtonElement>('[data-print]'); if (button) { button.hidden = false; button.addEventListener('click', () => window.print()); }</script>
</BaseLayout>
