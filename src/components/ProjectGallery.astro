---
import Icon from './Icon.astro';
import { projects, partitionProjects, profile, type Project } from '../data/portfolio';
interface Props { items?: Project[] }
const { items = projects } = Astro.props;
const { featured, more } = partitionProjects(items);
---
<div class="project-grid">
  {featured.map((project, index) => <article class="project-card" data-reveal>
    <div class="project-art" aria-hidden="true"><span class="project-index">EXPERIMENT / {String(index + 1).padStart(2, '0')}</span><span class="project-letter">{project.title.slice(0, 1)}</span><svg class="project-art-layers" viewBox="0 0 120 130" fill="none" focusable="false"><path d="m12 79 52-24 45 23-52 26Z" fill="#A58E70"/><path d="m12 57 52-24 45 23-52 26Z" fill="#F3EDE2"/><path d="m12 35 52-24 45 23-52 26Z" fill="#C7351D"/></svg><span class="project-art-caption">{project.title === 'Kubera' ? 'REALITY → RECOVERY' : project.title.toUpperCase()}</span><span class="project-art-fold"></span></div>
    <div class="project-card-body"><div class="project-title-row"><h3>{project.title}</h3><span class="project-status"><span></span>{project.status}</span></div><p>{project.summary}</p><ul class="tags" aria-label="Technologies">{project.technologies.map(tag => <li>{tag}</li>)}</ul>
      <details class="project-details" data-project-details={project.id}><summary data-project-open={project.id}>Explore {project.title}<Icon name="plus" /></summary><div class="project-detail-content">{project.details.map(detail => <section><h4>{detail.heading}</h4><p>{detail.text}</p></section>)}<div class="project-detail-links">{project.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noreferrer">{link.label} <Icon name="external" /></a>)}</div></div></details>
    </div>
  </article>)}
</div>
<div class="more-projects" data-reveal><div><p class="eyebrow">THE REST OF THE WORKBENCH</p><h3>More projects & experiments</h3></div><div class="archive-list">{more.map(project => <details class="archive-project"><summary>{project.title}<span>{project.status} <Icon name="plus" /></span></summary><p>{project.summary}</p>{project.details.map(detail => <section><h4>{detail.heading}</h4><p>{detail.text}</p></section>)}{project.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noreferrer">{link.label} <Icon name="external" /></a>)}</details>)}<a class="archive-github" href={profile.github} target="_blank" rel="noreferrer"><span>Follow what I’m building on GitHub<small>New ideas, experiments, and the work in progress.</small></span><Icon name="external" /></a></div></div>
{featured.map(project => <dialog class="project-dialog" id={`project-${project.id}`} aria-labelledby={`dialog-title-${project.id}`}><div class="dialog-shell"><div class="dialog-top"><span class="eyebrow">INDEPENDENT PROJECT</span><button class="dialog-close" type="button" aria-label={`Close ${project.title} details`}>Close <Icon name="close" /></button></div><p class="project-status">{project.status}</p><h2 id={`dialog-title-${project.id}`}>{project.title}<span class="accent">.</span></h2><p class="dialog-intro">{project.summary}</p><ul class="tags">{project.technologies.map(tag => <li>{tag}</li>)}</ul><div class="dialog-content"></div></div></dialog>)}
