---
import { iconPaths, type IconName } from '../data/icons';
interface Props { name: IconName; class?: string }
const { name, class: className } = Astro.props;
---
<svg class:list={['icon', className]} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {iconPaths[name].map(d => <path d={d} />)}
</svg>
